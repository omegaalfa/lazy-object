{
    "name":  "omegaalfa/lazy-object",
    "description":  "Small facade for PHP 8.4 native lazy proxies and lazy ghosts",
    "type":  "library",
    "license":  "proprietary",
    "keywords":  [
                     "php",
                     "lazy-object",
                     "lazy-proxy",
                     "lazy-ghost",
                     "reflection"
                 ],
    "authors":  [
                    {
                        "name":  "wrt",
                        "email":  "webdesenvolver.agenda@gmail.com"
                    }
                ],
    "require":  {
                    "php":  "\u003e=8.4"
                },
    "require-dev":  {
                        "phpstan/phpstan":  "^2.1",
                        "phpunit/phpunit":  "^12.5"
                    },
    "autoload":  {
                     "psr-4":  {
                                   "Omegaalfa\\LazyObject\\":  "src/"
                               }
                 },
    "autoload-dev":  {
                         "psr-4":  {
                                       "Omegaalfa\\LazyObject\\Tests\\":  "tests/"
                                   }
                     },
    "scripts":  {
                    "test":  "phpunit",
                    "coverage":  "phpunit --coverage-text",
                    "phpstan":  "phpstan analyse --no-progress"
                },
    "minimum-stability":  "dev",
    "prefer-stable":  true
}
