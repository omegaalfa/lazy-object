{
  "name": "omegaalfa/lazy-object",
  "description": "Lazy Objects in PHP",
  "minimum-stability": "dev",
  "license": "proprietary",
  "authors": [
    {
      "name": "wrt",
      "email": "webdesenvolver.agenda@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.4"
  },
  "autoload": {
    "psr-4": {
      "Omegaalfa\\LazyObject\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Omegaalfa\\LazyObject\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0 || ^12.0",
    "phpstan/phpstan": "^1.11 || ^2.0"
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse src tests --level=5"
  }
}